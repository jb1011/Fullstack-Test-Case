{
  "name": "merkl",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "merkl",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@merkl/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@merkl/web",
      "version": "0.0.0"
    },
    "node_modules/@merkl/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@merkl/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@merkl/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@merkl/shared",
      "version": "0.0.0"
    }
  }
}
